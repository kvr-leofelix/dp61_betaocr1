# LumenEIOS Environment Configuration Template

APP_NAME=LumenEIOS
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=lumeneios-super-secure-production-ready-secret-key-32charsmin!
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database: SQLite for instant zero-dependency local runs, or PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./lumeneios.db
# DATABASE_URL=postgresql+asyncpg://lumeneios_user:lumeneios_secret_pass@localhost:5432/lumeneios_db

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Object Storage (MinIO or AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=lumeneios-documents
STORAGE_LOCAL_DIR=./storage_uploads

# OCR Engine
ACTIVE_OCR_PROVIDER=simulated
OCR_CONFIDENCE_THRESHOLD=0.85
HF_TOKEN=
DEFAULT_VISION_MODEL=microsoft/trocr-base-handwritten
QWEN_VL_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct-AWQ

# AI / LLM Provider
LLM_PROVIDER=deterministic
LLM_API_KEY=

# Optional Neo4j Knowledge Graph
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis Cache / Tasks
REDIS_URL=redis://localhost:6379/0

# Demo Mode (seed accounts active, easy tenant switching)
DEMO_MODE=true